PORT=4010
DOCKER_SOCKET_PATH=/var/run/docker.sock
PROXY_PUBLIC_BASE_URL=http://localhost:4010
PROXY_TOKEN_SECRET=replace-with-a-long-random-secret
LAB_MANAGER_API_KEY=replace-with-a-shared-secret

DEFAULT_TTL_MINUTES=60
READY_TIMEOUT_MS=30000
INSTANCE_MEMORY_MB=256
INSTANCE_NANO_CPUS=500000000
TARGET_CONTAINER_PORT=8000

# Comma-separated labId=image allowlist. The Next.js app sends the lab slug.
ALLOWED_LAB_IMAGES=sqli-momo=ghana-cybersim/sqli-momo:latest,cmdi-netcheck=ghana-cybersim/cmdi-netcheck:latest
