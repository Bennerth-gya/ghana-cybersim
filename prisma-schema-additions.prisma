// Reference only: the active lab schema lives in prisma/schema.prisma.

model Lab {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  difficulty  ScenarioDifficulty
  category    String
  dockerImage String
  flagHash    String
  points      Int      @default(100)
  createdAt   DateTime @default(now())

  instances LabInstance[]
}

model LabInstance {
  id          String    @id @default(cuid())
  labId       String
  lab         Lab       @relation(fields: [labId], references: [id])
  userId      String
  status      String
  accessUrl   String?
  externalId  String?
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  destroyedAt DateTime?

  submissions FlagSubmission[]
}

model FlagSubmission {
  id            String      @id @default(cuid())
  labInstanceId String
  labInstance   LabInstance @relation(fields: [labInstanceId], references: [id])
  userId        String
  submittedFlag String
  isCorrect     Boolean
  submittedAt   DateTime    @default(now())
}
