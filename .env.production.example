# =============================================================================
# Ghana CyberSim — PRODUCTION Environment Variables Template
# =============================================================================
# Copy this file to .env.production and fill in EVERY value.
# .env.production is already in .gitignore — NEVER commit real secrets.
#
# Sections:
#   1. Site / Public
#   2. Authentication (Hexclave / Stack Auth)
#   3. Database (Supabase Postgres)
#   4. Lab Manager Microservice
#   5. Optional Features
# =============================================================================


# ── 1. SITE / PUBLIC ─────────────────────────────────────────────────────────

# Your deployed Next.js domain (no trailing slash).
# On Vercel this is typically https://YOUR_PROJECT.vercel.app
# or your custom domain, e.g. https://cybersim.example.edu.gh
NEXT_PUBLIC_SITE_URL="https://YOUR_DOMAIN_HERE"


# ── 2. AUTHENTICATION — Hexclave (Stack Auth) ─────────────────────────────────
#
# ⚠  IMPORTANT: Create a SEPARATE Hexclave project for production.
#    Dev and prod MUST NOT share a project — they have different allowed
#    callback URLs, and mixing them exposes dev tokens to prod.
#
# Steps:
#   1. Go to https://app.stack-auth.com
#   2. Click "New Project" → name it e.g. "CyberSim Production"
#   3. Under Project Settings → Domains, add your production domain
#   4. Copy the Project ID and Secret Server Key below
#   5. Under Auth Settings, ensure OAuth providers (if any) list your prod domain
#
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NEXT_PUBLIC_HEXCLAVE_API_URL="https://api.stack-auth.com"
HEXCLAVE_SECRET_SERVER_KEY="ssk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# ── 3. DATABASE — Supabase Postgres ──────────────────────────────────────────
#
# Use the TRANSACTION POOLER (port 6543, pgbouncer=true) for the app.
# Use the SESSION POOLER (port 5432, no pgbouncer) for migrations only.
#
# To find these:
#   1. Go to https://supabase.com/dashboard → your project
#   2. Settings → Database → Connection string
#   3. Select "Transaction" mode → copy → paste as DATABASE_URL
#   4. Select "Session" mode → copy → paste as DIRECT_URL
#
# ⚠  The password is your database password set during project creation.
#    If you forgot it: Settings → Database → Reset database password.
#
# Pattern:
#   Transaction (pooled):  postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#   Session (direct):      postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"


# ── 4. LAB MANAGER MICROSERVICE ──────────────────────────────────────────────
#
# The lab manager is a separate Node/Express service that provisions Docker
# containers. It CANNOT run on Vercel — it requires a VPS with Docker installed.
#
# LAB_MANAGER_URL: The public HTTPS address of your lab manager server.
#   This must be HTTPS in production — the API key travels in every request.
#   Example: https://labs.cybersim.example.edu.gh
#   (Set up via Caddy or nginx + Let's Encrypt on your VPS)
#
LAB_MANAGER_URL="https://labs.YOUR_DOMAIN_HERE"

# LAB_MANAGER_API_KEY: A strong shared secret.
#   ⚠  THIS VALUE MUST BE IDENTICAL on BOTH:
#     - This file (Next.js app)
#     - The lab manager's .env file on the VPS
#
#   Generate one with:
#     openssl rand -hex 32
#
#   Example output: a3f8c2e1b9d7054f6a21e3c8b5d409f12e7a6c3d0b1e4f8a2c9d6e3b7f0a1d4
#
LAB_MANAGER_API_KEY="GENERATE_WITH: openssl rand -hex 32"

# PROXY_TOKEN_SECRET: Used by the lab manager to sign time-limited proxy URLs.
#   Set this in lab-manager/.env on the Docker host. The Next.js app does not
#   read it directly.
#   Generate with: openssl rand -hex 32
#
PROXY_TOKEN_SECRET="GENERATE_WITH: openssl rand -hex 32"


# ── 5. OPTIONAL FEATURES ──────────────────────────────────────────────────────

# Anthropic API key — only needed if AI_FEATURES_ENABLED=true
ANTHROPIC_API_KEY=""
AI_FEATURES_ENABLED="false"
