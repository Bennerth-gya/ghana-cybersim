# Public app URL used for metadata, auth callbacks, and deployment checks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# MVP auth decision: use Hexclave for authentication
# Get these values from your Hexclave dashboard at https://app.hexclave.com
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID="your-project-id-here"
NEXT_PUBLIC_HEXCLAVE_API_URL="https://api.hexclave.com"
HEXCLAVE_SECRET_SERVER_KEY="your-secret-server-key-here"

# Production database decision: managed Postgres with Prisma migrations.
# For local development, you can use:
# - PostgreSQL installed locally
# - Docker: docker run --name ghana-cybersim-db -e POSTGRES_PASSWORD=password -e POSTGRES_DB=ghana_cybersim -p 5432:5432 -d postgres:16
# - Cloud services: Supabase, Neon, Railway, Render
DATABASE_URL="postgresql://postgres:password@localhost:5432/ghana_cybersim?schema=public"

# Optional after the deterministic report workflow is working.
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
AI_FEATURES_ENABLED="false"

# Docker lab manager integration. The Next.js app calls this service to
# provision and destroy per-user vulnerable containers.
LAB_MANAGER_URL="http://localhost:4010"
LAB_MANAGER_API_KEY="2a3484b4d27135df60eea460a928771f40c0550ab9f2e471c71f863ad2baedbb"
